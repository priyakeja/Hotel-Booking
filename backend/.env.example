# ---------------------------------------------------------------------------
# Copy this file to `backend/.env` and fill in your local values.
# ---------------------------------------------------------------------------

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# --- MySQL -----------------------------------------------------------------
DB_NAME=skystay_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Email -----------------------------------------------------------------
# Leave EMAIL_HOST_USER empty to print mails to the console (zero-config dev).
# For Gmail use an *app password* (Account → Security → 2-Step Verification →
# App passwords), never the account password. Spaces are stripped automatically.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SkyStay <no-reply@example.com>
# Where "new booking" notices go; defaults to EMAIL_HOST_USER.
BOOKING_NOTIFICATION_EMAIL=

# --- Frontend --------------------------------------------------------------
# Used by the admin "VIEW SITE" link and the backend landing page at "/".
FRONTEND_URL=http://localhost:5173

# --- Media -----------------------------------------------------------------
MEDIA_URL=/media/
MEDIA_ROOT=

# --- Razorpay --------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- CORS (Vite dev server / production frontend origins) -------------------

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
